// WorldScope persistence.
//
// Country data itself is never stored: it is fetched from public providers and
// cached in Redis. Only user-created, anonymous records live in PostgreSQL.
//
// `clientId` is a random identifier generated by the browser and sent through
// the `x-client-id` header. It is not authentication: anyone who copies the
// value gains access to those records. See docs/architecture.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FavoriteCountry {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.VarChar(64)
  countryCode String   @map("country_code") @db.VarChar(3)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([clientId, countryCode])
  @@index([clientId, createdAt])
  @@map("favorite_countries")
}

model SavedComparison {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.VarChar(64)
  name         String?  @db.VarChar(120)
  countryCodes String[] @map("country_codes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([clientId, updatedAt])
  @@map("saved_comparisons")
}
