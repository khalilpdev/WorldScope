{
  "name": "worldscope",
  "version": "1.0.0",
  "private": true,
  "description": "WorldScope — Global Data Intelligence: explore, visualise and compare public country data.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @worldscope/shared build && pnpm --parallel --filter @worldscope/api --filter @worldscope/web dev",
    "dev:api": "pnpm --filter @worldscope/shared build && pnpm --filter @worldscope/api dev",
    "dev:web": "pnpm --filter @worldscope/shared build && pnpm --filter @worldscope/web dev",
    "build": "pnpm --filter @worldscope/shared build && pnpm --filter @worldscope/api build && pnpm --filter @worldscope/web build",
    "start": "pnpm --filter @worldscope/api start:prod",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @worldscope/web test:e2e",
    "db:generate": "pnpm --filter @worldscope/api prisma:generate",
    "db:migrate": "pnpm --filter @worldscope/api prisma:migrate",
    "db:deploy": "pnpm --filter @worldscope/api prisma:deploy",
    "db:studio": "pnpm --filter @worldscope/api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"  }
}
