# ---------------------------------------------------------------------------
# WorldScope environment template. Copy to .env and adjust for your machine.
# Never commit real secrets. The MVP requires no third-party API keys.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Application -----------------------------------------------------------
# Port the NestJS API listens on.
API_PORT=3000
# Port the Vite dev server listens on.
WEB_PORT=5173
# Comma-separated list of browser origins allowed by CORS.
WEB_ORIGIN=http://localhost:5173

# --- Infrastructure --------------------------------------------------------
# Development mode (API and web run on the host, database and Redis in Compose).
DATABASE_URL=postgresql://worldscope:worldscope_dev@127.0.0.1:5432/worldscope?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Values consumed by docker compose to create the containers.
POSTGRES_USER=worldscope
POSTGRES_PASSWORD=worldscope_dev
POSTGRES_DB=worldscope
# Exposed on 127.0.0.1 only. Change the host port if 5432 is already taken.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- External data providers (all keyless) ---------------------------------
# Country catalogue: pinned commit of the mledoze/countries dataset (ODbL 1.0).
COUNTRY_CATALOG_BASE_URL=https://raw.githubusercontent.com/mledoze/countries/5d15c0ff8c87ef2f1f8e944093522d4b2de2dd5b
# Flag images (no key required).
FLAG_CDN_BASE_URL=https://flagcdn.com
# World Bank indicators API.
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
# Open-Meteo forecast API.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Resilience and caching ------------------------------------------------
# Outbound HTTP timeout in milliseconds.
HTTP_TIMEOUT_MS=8000
# Cache TTLs in seconds (86400 = 24h, 1800 = 30min).
CACHE_TTL_CATALOG_SECONDS=86400
CACHE_TTL_INDICATORS_SECONDS=86400
CACHE_TTL_WEATHER_SECONDS=1800
# Set to false to bypass Redis entirely (the API falls back to in-memory cache).
CACHE_ENABLED=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- Web (production container) -------------------------------------------
# Port used to expose the built frontend when every service runs in Docker.
WEB_CONTAINER_PORT=8080
